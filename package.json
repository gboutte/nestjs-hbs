{
  "name": "@gboutte/nestjs-hbs",
  "version": "0.2.0",
  "description": "This package provide a service to render handlebars templates for nestjs.",
  "keywords": [
    "nestjs",
    "handlebars",
    "hbs",
    "templates"
  ],
  "homepage": "https://github.com/gboutte/nestjs-hbs#readme",
  "bugs": {
    "url": "https://github.com/gboutte/nestjs-hbs/issues",
    "email": "gboutte@protonmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gboutte/nestjs-hbs.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts}\""
  },
  "author": "Grégory Boutte <gboutte@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "handlebars": "^4.7.9",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "handlebars": "^4.7.9"
  }
}
